      "vo_num_8": "आठ",
      "vo_num_9": "नौ",
      "vo_p13_measure": "बेंच को ब्लॉक से मापिए।",
      "vo_p2_ask": "इनमें से कौन-सी टेबल ज्यादा लंबी है? उस पर टैप करिए।",
      "vo_p2_fb": "यह टेबल ज्यादा लंबी है।",
