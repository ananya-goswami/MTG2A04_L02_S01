    "audio_text": {
      "vo_landing": "नमस्ते दोस्त! मैं हूँ स्विफ्टी। आज हम सीखेंगे - किसी चीज की लंबाई कैसे मापते हैं।",
      "vo_match_instr": "हर चीज़ को उसके सही माप से मिलाइए।",
      "vo_match_ok": "शाबाश! आपने सभी चीज़ों को उनके सही माप से मिला दिया।",
      "vo_num_1": "एक",
      "vo_num_2": "दो",
      "vo_num_3": "तीन",
      "vo_num_4": "चार",
      "vo_num_5": "पाँच",
      "vo_num_6": "छह",
      "vo_num_7": "सात",
      "vo_num_8": "आठ",
      "vo_num_9": "नौ",
      "vo_p13_measure": "बेंच को ब्लॉक से मापिए।",
      "vo_p2_ask": "इनमें से कौन-सी टेबल ज्यादा लंबी है? उस पर टैप करिए।",
      "vo_p2_fb": "यह टेबल ज्यादा लंबी है।",
      "vo_p3_done": "शाबाश! यह टेबल 6 ब्लॉक्स लंबी है।",
      "vo_p4_done": "शाबाश! यह दरवाजा 5 ब्लॉक्स लंबा है।",
      "vo_p5_instr": "पलंग की लंबाई ब्लॉक से मापिए।",
      "vo_p7_ask": "अब बताइए, फ्रिज की लंबाई कितनी है?",
      "vo_p6b_ok": "शाबाश! तकिये की लंबाई 3 ब्लॉक्स है।",
      "vo_p6b_ask": "अब बताइए, तकिये की लंबाई कितनी है?",
      "vo_p6b_instr": "तकिये की लंबाई ब्लॉक से मापिए।",
      "vo_p6_instr": "अलमारी की लंबाई ब्लॉक से मापिए।",
      "vo_p5_ask": "अब बताइए, पलंग की लंबाई कितनी है?",
      "vo_p5_ok": "शाबाश! पलंग की लंबाई 8 ब्लॉक्स है।",
      "vo_p6_ask": "अब बताइए, अलमारी की लंबाई कितनी है?",
      "vo_p6_ok": "शाबाश! अलमारी की लंबाई 4 ब्लॉक्स है।",
      "vo_p7_instr": "फ्रिज की लंबाई ब्लॉक से मापिए।",
      "vo_p7_ok": "शाबाश! फ्रिज की लंबाई 4 ब्लॉक्स है।",
      "vo_p8_ask": "कौन-सी चटाई ज़्यादा लंबी है? उस पर टैप करिए।",
      "vo_p8_ok": "शाबाश! यह चटाई ज़्यादा लंबी है।",
      "vo_p9_ask": "कौन-सी कुर्सी ज़्यादा लंबी है? उस पर टैप करिए।",
      "vo_p9_ok": "शाबाश! यह कुर्सी ज़्यादा लंबी है।",
      "vo_pt_guided": "बहुत बढ़िया! अब हम साथ मिलकर शुरू करते हैं। चलिए, साथ में करें!",
      "vo_pt_practice": "वाह! अब आपकी बारी।",
      "vo_pt_tutorial": "ध्यान से देखिए और मेरे साथ जानिए। चलिए, शुरू करें!",
      "vo_p3_head": "यह टेबल कितनी लंबी है? चलिए, इसे ब्लॉक से मापकर देखते हैं।",
      "vo_p3_explain_a": "इसके लिए हम टेबल के एक छोर से मापना शुरू करेंगे।",
      "vo_p3_explain_b": "फिर एक-एक ब्लॉक रखते हुए दूसरे छोर तक जाएंगे।",
      "vo_demo_start": "चलिए, शुरू करते हैं।",
      "vo_rule_a": "अब ध्यान रखें! हर अगला ब्लॉक वहीं से शुरू करें, जहाँ पिछला खत्म हुआ था।",
      "vo_rule_b": "बीच में जगह न छोड़ें,",
      "vo_rule_c": "और एक-दूसरे के ऊपर न रखें।",
      "vo_p3_child": "अब आगे आप मापिए और बताइए, टेबल कितने ब्लॉक लंबी है।",
      "vo_p4_head": "क्या आप बता सकते हैं, यह दरवाजा कितना लंबा है? चलिए, इसे ब्लॉक से मापकर देखते हैं।",
      "vo_p4_explain_a": "इसके लिए हम दरवाजे के निचले छोर से मापना शुरू करेंगे",
      "vo_p4_explain_b": "और ऊपर तक जाएंगे।",
      "vo_p4_child": "अब आगे आप मापिए और बताइए, दरवाजे की लंबाई कितनी है।",
      "vo_well_done": "शाबाश! आपने ब्लॉक्स से लंबाई मापना सीख लिया!",
      "vo_p13_intro": "आज हमें कक्षा सजानी है! हर चीज़ अपनी सही जगह पर ही फिट होगी। ब्लॉक से मापिए और सही जगह चुनिए।",
      "vo_p13_place": "अब बेंच के लिए सही जगह चुनिए।",
      "vo_hint_mcq2_1": "दोनों विकल्पों को ध्यान से देखिए और सोचिए।",
      "vo_hint_mcq2_2": "ध्यान से देखिए और सही विकल्प चुनिए।",
      "vo_ok_mcq2": "शाबाश! आपने सही चुना।",
      "vo_hint_mcq3_1": "फिर से सोचिए और विकल्पों को ध्यान से देखिए।",
      "vo_hint_mcq3_2": "चित्र को ध्यान से देखिए और सही उत्तर पहचानिए।",
      "vo_hint_dd_1": "फिर से सोचिए। ध्यान से देखिए और सही जगह चुनिए।",
      "vo_hint_dd_2": "ब्लॉक्स को ध्यान से गिनिए और सही जगह पर रखिए।",
      "vo_ok_dd": "शाबाश! सही जगह पर रखा।"
    },
